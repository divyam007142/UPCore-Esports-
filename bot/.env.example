# UPCORE Esports Bot — Environment Variables
# Copy this file to .env and fill in your values

DISCORD_BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
MONGODB_URI=your_mongodb_connection_string_here
ADMIN_ROLE_ID=your_admin_role_id_here
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
WELCOME_LOG_CHANNEL_ID=your_welcome_log_channel_id_here
LOGS_CHANNEL_ID=your_logs_channel_id_here

# ─── Ticket System ─────────────────────────────────────────────────────────────
# Channel where the support panel embed is sent
TICKET_PANEL_ID=your_ticket_panel_channel_id_here

# Channel where ticket actions are logged (open, close, claim, delete, etc.)
TICKET_LOG_CHANNEL_ID=your_ticket_log_channel_id_here

# Role that has access to manage tickets (support staff)
TICKET_SUPPORT_ROLE_ID=your_ticket_support_role_id_here

# Discord category channel IDs — each ticket type opens in its own category
TICKET_CATEGORY_ID1=general_support_category_id_here
TICKET_CATEGORY_ID2=tournament_support_category_id_here
TICKET_CATEGORY_ID3=club_join_request_category_id_here
TICKET_CATEGORY_ID4=business_enquiries_category_id_here
TICKET_CATEGORY_ID5=others_category_id_here
